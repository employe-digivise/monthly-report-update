# Server Configuration (lokal/development saja — di Modal, PORT diatur oleh modal_app.py)
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# Anthropic Claude — for auto-generating empty insight fields
# Di production (Modal), key diambil dari Modal Secret `anthropic-api-key`.
ANTHROPIC_API_KEY=
INSIGHT_AI_MODEL=claude-haiku-4-5-20251001
INSIGHT_AI_DISABLED=0

# PDF engine: puppeteer (default, Chromium) | weasyprint | pdfmake
# - puppeteer  : current baseline, highest fidelity, ~1GB RAM/render.
# - weasyprint : HTML->PDF tanpa Chromium, ~-75% RAM, fidelity setara. Butuh binary
#                weasyprint + lib pango/cairo/gdk-pixbuf. macOS: brew install pango gdk-pixbuf.
# - pdfmake    : in-process, paling ringan TAPI butuh rewrite layout penuh (belum lengkap).
PDF_ENGINE=puppeteer
# Path ke binary weasyprint (default: 'weasyprint'; di Mac dev ini /opt/anaconda3/bin/weasyprint).
WEASYPRINT_BIN=
# macOS only: lokasi lib Homebrew untuk WeasyPrint (default /opt/homebrew/lib).
WEASYPRINT_DYLD=
