# Server Configuration (lokal/development saja — di Modal, PORT diatur oleh modal_app.py)
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Insight AI ──────────────────────────────────────────────────────
# Which LLM fills/previews insight fields. "nvidia" (default) | "anthropic".
INSIGHT_AI_PROVIDER=nvidia

# NVIDIA (OpenAI-compatible chat completions). Default model meta/llama-3.3-70b-instruct.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic Claude (fallback provider). At Modal, key comes from Secret `anthropic-api-key`.
ANTHROPIC_API_KEY=

# Override model for the ACTIVE provider. Leave BLANK to use the provider default:
#   nvidia    -> meta/llama-3.3-70b-instruct
#   anthropic -> claude-haiku-4-5-20251001
INSIGHT_AI_MODEL=

# Per-LLM-call timeout in ms. NVIDIA's hosted llama-3.3-70b can be slow on
# cold start — 60000 is recommended (the generate route has a 120s budget).
INSIGHT_AI_TIMEOUT_MS=60000

# Retries per slot on transient errors (timeout, DNS blip, 429, 5xx). Default 2.
INSIGHT_AI_RETRIES=2

# "1" disables the generate-path auto-fill safety net (the /preview-insights
# endpoint still works regardless). "0" enables it.
INSIGHT_AI_DISABLED=0

# PDF engine: pdfmake (default, native) | puppeteer | weasyprint
# - pdfmake    : native in-process (tanpa browser/subprocess), ~110MB RAM/render
#                (−90% vs Chromium). Laporan aurora penuh dibangun sebagai
#                docDefinition di execution/renderers/pdfmake/.
# - puppeteer  : HTML->PDF via Chromium, ~1GB RAM/render. Butuh `npm install`
#                dengan devDependencies (puppeteer bukan dependency production lagi).
# - weasyprint : HTML->PDF tanpa Chromium, ~-75% RAM. Butuh binary weasyprint +
#                lib pango/cairo/gdk-pixbuf. macOS: brew install pango gdk-pixbuf.
PDF_ENGINE=pdfmake
# Path ke binary weasyprint (default: 'weasyprint'; di Mac dev ini /opt/anaconda3/bin/weasyprint).
WEASYPRINT_BIN=
# macOS only: lokasi lib Homebrew untuk WeasyPrint (default /opt/homebrew/lib).
WEASYPRINT_DYLD=
