<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= brandName %> - Monthly Report</title>
    <style><%- cssContent %></style>
</head>

<body>

<% var _pageCount=0; var nextPage=function() { return ++_pageCount; }; %>

<!-- ============================================================
     1. COVER PAGE — Aurora Gradient with Geometric Shapes
     ============================================================ -->
<div class="page">
    <div class="cover-page">
        <!-- Aurora SVG decoration -->
        <svg class="cover-aurora-shape" viewBox="0 0 300 300" fill="none">
            <circle cx="150" cy="150" r="140" stroke="rgba(255,107,44,0.3)" stroke-width="1" fill="none"/>
            <circle cx="150" cy="150" r="110" stroke="rgba(255,107,44,0.2)" stroke-width="1" fill="none"/>
            <circle cx="150" cy="150" r="80" stroke="rgba(255,107,44,0.15)" stroke-width="1" fill="none"/>
            <path d="M50 150 Q150 50 250 150 Q150 250 50 150Z" fill="rgba(255,107,44,0.05)"/>
        </svg>

        <div class="cover-content">
            <p class="cover-label">Monthly Performance Report</p>
            <h1 class="cover-title">MONTHLY<br><span>REPORT</span></h1>
            <div class="cover-divider"></div>
            <p class="cover-brand"><%= brandName %></p>
            <p class="cover-month"><%= reportMonth %> &mdash; <%= reportYear %></p>
        </div>
    </div>
    <% if (typeof showLogo !=='undefined' && showLogo && typeof logoUrl !=='undefined' && logoUrl) { %>
        <img src="<%= logoUrl %>" class="agency-logo" alt="Agency Logo">
    <% } %>
    <div class="page-footer" style="z-index:5;">
        <span style="color:rgba(255,255,255,0.5);"><%= (typeof footerText !=='undefined' && footerText) ? ((typeof showLogo !== 'undefined' && showLogo) ? footerText : footerText.replace('DIGIVISE ', '')) : 'CONFIDENTIAL' %></span>
        <span style="color:rgba(255,255,255,0.5);">Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     2. SECTION DIVIDER: PERFORMANCE OVERVIEW
     ============================================================ -->
<div class="page">
    <div class="section-divider">
        <div class="section-divider-left">
            <div class="section-number-bg">01</div>
            <div class="section-number">01</div>
        </div>
        <div class="section-divider-right">
            <h1 class="section-title">Performance<br>Overview</h1>
        </div>
    </div>
    <div class="page-footer" style="z-index:5;">
        <span style="color:rgba(255,255,255,0.5);"><%= brandName %> | <%= reportMonth %></span>
        <span style="color:rgba(255,255,255,0.5);">Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     3. OPERATIONAL PERFORMANCE — KPI Cards + Screenshots
     ============================================================ -->
<div class="page">
    <div class="aurora-decoration aurora-blob-tr"></div>
    <div class="content-header">
        <h2>Performa Operasional Toko</h2>
    </div>

    <div class="kpi-grid" style="margin-bottom: 16px;">
        <div class="kpi-card">
            <p class="kpi-card__label">Pesanan Tidak Terselesaikan</p>
            <p class="kpi-card__value"><%= (typeof metrics !=='undefined' && metrics.unfulfilledOrders) ? metrics.unfulfilledOrders : 0 %><span class="kpi-card__suffix">%</span></p>
        </div>
        <div class="kpi-card">
            <p class="kpi-card__label">Keterlambatan Pengiriman</p>
            <p class="kpi-card__value"><%= (typeof metrics !=='undefined' && metrics.lateShipment) ? metrics.lateShipment : 0 %><span class="kpi-card__suffix">%</span></p>
        </div>
        <div class="kpi-card kpi-card--accent">
            <p class="kpi-card__label">Chat Dibalas</p>
            <p class="kpi-card__value kpi-card__value--highlight"><%= (typeof metrics !=='undefined' && metrics.chatResponseRate) ? metrics.chatResponseRate : 0 %><span class="kpi-card__suffix">%</span></p>
        </div>
        <div class="kpi-card kpi-card--accent">
            <p class="kpi-card__label">Penilaian Keseluruhan</p>
            <p class="kpi-card__value kpi-card__value--highlight"><%= (typeof metrics !=='undefined' && metrics.overallRating) ? metrics.overallRating : 0 %><span class="kpi-card__suffix">/5</span></p>
        </div>
    </div>

    <!-- Screenshots -->
    <div style="padding: 0 24mm;">
        <div class="screenshot-container">
            <% if (typeof operationalScreenshots !=='undefined' && operationalScreenshots && operationalScreenshots.length > 0) { %>
                <div class="screenshot-pair">
                    <% operationalScreenshots.slice(0, 2).forEach(src => { %>
                        <img src="<%= src %>" class="screenshot-img" alt="Operational Screenshot">
                    <% }) %>
                </div>
            <% } else { %>
                <div class="screenshot-pair">
                    <div style="width:100%;height:200px;background:var(--primary-pale);border:2px dashed var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 1 Placeholder]</span>
                    </div>
                    <div style="width:100%;height:200px;background:var(--primary-pale);border:2px dashed var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 2 Placeholder]</span>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Summary -->
    <% if (typeof metrics !=='undefined' && metrics.summary) { %>
    <div style="padding: 14px 24mm 0;">
        <div class="summary-box">
            <p class="summary-box__title">Summary</p>
            <% var _mPoints = (metrics.summary || '').split(/(?:^|\s)(?:\d+[\.\)]\s*|- )/).filter(function(s){ return s.trim(); });
               if (_mPoints.length > 1) { %>
                <ul style="padding-left:16px;list-style-type:disc;margin:0;">
                    <% _mPoints.forEach(function(point) { %>
                        <li style="font-size:10px;color:var(--text-body);margin-bottom:3px;line-height:1.5;"><%= point.trim() %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="summary-box__text"><%= metrics.summary %></p>
            <% } %>
        </div>
    </div>
    <% } %>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     4. PROMOTION TOOLS
     ============================================================ -->
<div class="page">
    <div class="aurora-decoration aurora-blob-bl"></div>
    <div class="content-header">
        <h2>Tingkat Penggunaan Alat Promosi</h2>
    </div>

    <div style="padding: 0 24mm;">
        <div class="screenshot-container">
            <% if (typeof promotionScreenshots !=='undefined' && promotionScreenshots && promotionScreenshots.length > 0) { %>
                <div class="screenshot-pair">
                    <% promotionScreenshots.slice(0, 2).forEach(src => { %>
                        <img src="<%= src %>" class="screenshot-img" alt="Promotion Screenshot">
                    <% }) %>
                </div>
            <% } else { %>
                <div class="screenshot-pair">
                    <div style="width:100%;height:200px;background:var(--primary-pale);border:2px dashed var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 1 Placeholder]</span>
                    </div>
                    <div style="width:100%;height:200px;background:var(--primary-pale);border:2px dashed var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 2 Placeholder]</span>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <div style="padding: 16px 24mm 0;">
        <p style="font-size: 13px; font-weight: 800; margin-bottom: 14px; color: var(--text-dark); font-family: 'Montserrat', sans-serif;">Penggunaan Alat Promosi</p>
        <ul class="checklist-container">
            <% if (typeof promotionTools !=='undefined' && promotionTools) {
                Object.keys(promotionTools).forEach(tool => { %>
                    <li class="checklist-item checklist-item--<%= promotionTools[tool] ? 'active' : 'inactive' %>">
                        <%= tool.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %> <%= promotionTools[tool] ? 'digunakan' : 'tidak digunakan' %>
                    </li>
            <% }) } %>
        </ul>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     5. SECTION DIVIDER: GLOBAL PERFORMANCE
     ============================================================ -->
<div class="page">
    <div class="section-divider">
        <div class="section-divider-left">
            <div class="section-number-bg">02</div>
            <div class="section-number">02</div>
        </div>
        <div class="section-divider-right">
            <h1 class="section-title">Global<br>Performance</h1>
        </div>
    </div>
    <div class="page-footer" style="z-index:5;">
        <span style="color:rgba(255,255,255,0.5);"><%= brandName %> | <%= reportMonth %></span>
        <span style="color:rgba(255,255,255,0.5);">Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     6. GLOBAL REVENUE CHART
     ============================================================ -->
<div class="page">
    <div class="content-header">
        <h2>Global Revenue</h2>
    </div>

    <!-- Revenue & Orders KPI -->
    <div style="display:flex;gap:16px;padding:0 24mm 14px;justify-content:center;">
        <div class="revenue-accent-box" style="flex:1;max-width:220px;">
            <p class="revenue-label">Total Revenue</p>
            <p class="revenue-val" style="font-size:20px;">Rp <%= (typeof globalRevenue !=='undefined' && globalRevenue && globalRevenue.totalRevenue) ? (globalRevenue.totalRevenue/1000000000).toFixed(2) + 'M' : '0' %></p>
        </div>
        <div style="flex:1;max-width:220px;background:var(--gradient-accent);border-radius:14px;padding:18px 28px;text-align:center;box-shadow:0 4px 16px rgba(255,107,44,0.2);">
            <p style="font-size:10px;font-weight:600;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:4px;">Total Ads Spent</p>
            <% var _totalAdsSpent = 0; if (typeof globalRevenue !== 'undefined' && globalRevenue && globalRevenue.chartData && globalRevenue.chartData.adsSpentData) { _totalAdsSpent = globalRevenue.chartData.adsSpentData.reduce(function(a,b){ return a+b; }, 0); } %>
            <p style="font-family:'Montserrat',sans-serif;font-size:20px;font-weight:900;color:#fff;">Rp <%= (_totalAdsSpent/1000000000).toFixed(2) %>M</p>
        </div>
    </div>

    <div style="padding: 0 24mm; position: relative; height: 310px;">
        <% const safeGlobalRevenue=(typeof globalRevenue !=='undefined' && globalRevenue) ? globalRevenue : { chartData: { labels: [], revenueData: [], adsSpentData: [] }, summary: '' };
           const chartLabels=safeGlobalRevenue.chartData.labels || [];
           const revenueData=safeGlobalRevenue.chartData.revenueData || [];
           const adsData=safeGlobalRevenue.chartData.adsSpentData || [];
           const width=1000; const height=380;
           const padding={ top: 55, right: 30, bottom: 40, left: 75 };
           const chartWidth=width - padding.left - padding.right;
           const chartHeight=height - padding.top - padding.bottom;
           const maxRevenue=revenueData.length > 0 ? Math.max(...revenueData) : 0;
           const maxAds=adsData.length > 0 ? Math.max(...adsData) : 0;
           const maxValue=(Math.max(maxRevenue, maxAds) || 1) * 1.2;
           const getX=(index) => padding.left + (index * (chartWidth / (chartLabels.length - 1 || 1)));
           const barWidth = chartLabels.length > 0 ? (chartWidth / chartLabels.length) * 0.5 : 0;
           const getBarX = (index) => padding.left + (index * (chartWidth / (chartLabels.length || 1))) + ((chartWidth / (chartLabels.length || 1)) - barWidth) / 2;
           const getY = (value) => height - padding.bottom - (value / maxValue) * chartHeight;
           const formatCurrency = (val) => {
               if (val >= 1000000000) return 'Rp' + (val / 1000000000).toFixed(1) + 'M';
               if (val >= 1000000) return 'Rp' + (val / 1000000).toFixed(0) + 'jt';
               return 'Rp' + val.toLocaleString('id-ID');
           };
           const formatFullCurrency = (val) => 'Rp' + val.toLocaleString('id-ID');
        %>

        <!-- Legend -->
        <div style="display:flex;justify-content:flex-end;gap:20px;margin-bottom:8px;font-size:9px;color:var(--text-muted);">
            <div style="display:flex;align-items:center;gap:5px;">
                <span style="width:10px;height:10px;background:var(--primary);border-radius:3px;display:inline-block;"></span>
                Revenue
            </div>
            <div style="display:flex;align-items:center;gap:5px;">
                <span style="width:10px;height:10px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
                Ads Spent
            </div>
        </div>

        <svg viewBox="0 0 <%= width %> <%= height %>" style="width:100%;height:100%;font-family:'Inter',sans-serif;">
            <!-- Grid Lines -->
            <% for(let i=0; i<=5; i++) { const y=height - padding.bottom - (i * chartHeight / 5); const value=(maxValue / 5) * i; %>
                <line x1="<%= padding.left %>" y1="<%= y %>" x2="<%= width - padding.right %>" y2="<%= y %>" stroke="#EDE5FB" stroke-width="1" />
                <text x="<%= padding.left - 10 %>" y="<%= y + 4 %>" text-anchor="end" font-size="11" fill="#8C86A5"><%= formatCurrency(value) %></text>
            <% } %>

            <!-- Bars (Revenue) with rounded tops + gradient -->
            <defs>
                <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#A855F7" />
                    <stop offset="100%" stop-color="#6C2BD9" />
                </linearGradient>
            </defs>
            <% revenueData.forEach((val, i) => {
                const x = getBarX(i);
                const y = getY(val);
                const h = height - padding.bottom - y;
            %>
                <rect x="<%= x %>" y="<%= y %>" width="<%= barWidth %>" height="<%= h %>" fill="url(#barGrad)" rx="4" opacity="0.9" />
                <text x="<%= x + barWidth/2 %>" y="<%= y - 8 %>" text-anchor="middle" font-size="11" font-weight="700" fill="#6C2BD9"><%= formatFullCurrency(val) %></text>
            <% }) %>

            <!-- Line (Ads Spent) -->
            <polyline fill="none" stroke="#FF6B2C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="<%= adsData.map((val, i) => { const x = getBarX(i) + barWidth/2; const y = getY(val); return `${x},${y}`; }).join(' ') %>" />

            <!-- Points (Ads Spent) -->
            <% adsData.forEach((val, i) => {
                const x = getBarX(i) + barWidth/2;
                const y = getY(val);
            %>
                <circle cx="<%= x %>" cy="<%= y %>" r="4.5" fill="#FF6B2C" stroke="#fff" stroke-width="2" />
                <text x="<%= x %>" y="<%= y - 14 %>" text-anchor="middle" font-size="11" font-weight="700" fill="#FF6B2C"><%= formatFullCurrency(val) %></text>
            <% }) %>

            <!-- X Axis Labels -->
            <% chartLabels.forEach((label, i) => {
                const x = getBarX(i) + barWidth/2;
                const y = height - padding.bottom + 20;
            %>
                <text x="<%= x %>" y="<%= y %>" text-anchor="middle" font-size="11" fill="#8C86A5"><%= label %></text>
            <% }) %>
        </svg>
    </div>

    <!-- Summary -->
    <div style="padding: 0 24mm; margin-top: -10px;">
        <div class="summary-box">
            <p class="summary-box__title">Summary</p>
            <% var _gSummary = safeGlobalRevenue.summary || '';
               var _gPoints = _gSummary.split(/(?:^|\s)(?:\d+[\.\)]\s*|- )/).filter(function(s){ return s.trim(); });
               if (_gPoints.length > 1) { %>
                <ul style="padding-left:16px;list-style-type:disc;margin:0;">
                    <% _gPoints.forEach(function(point) { %>
                        <li style="font-size:10px;color:var(--text-body);margin-bottom:3px;line-height:1.5;"><%= point.trim() %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="summary-box__text"><%= _gSummary %></p>
            <% } %>
        </div>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     7. GLOBAL PERFORMANCE DETAIL TABLE
     ============================================================ -->
<div class="page">
    <div class="content-header">
        <h2>Global Performance</h2>
    </div>
    <div style="padding: 0 24mm;">
        <% const channelOrder=['shopee','tiktok','tokopedia','lazada','blibli'];
           const safeEnabledChannels=(typeof enabledChannels !=='undefined' && enabledChannels) ? enabledChannels : {};
           const enabledChannelsList=channelOrder.filter(ch => safeEnabledChannels[ch]);
           const channelCount = enabledChannelsList.length;
           const metricWidth = 20;
           const fixedColsWidth = 45;
           const availableWidth = 100 - metricWidth - fixedColsWidth;
           const channelColWidth = channelCount > 0 ? (availableWidth / channelCount).toFixed(1) : 0;
        %>
        <table class="performance-table">
            <thead>
                <tr>
                    <th style="width:<%= metricWidth %>%">Metriks</th>
                    <% enabledChannelsList.forEach(channel => { %>
                        <th style="width:<%= channelColWidth %>%"><%= channel.toUpperCase() %></th>
                    <% }) %>
                    <th style="width:15%">This Month</th>
                    <th style="width:15%">Last Month</th>
                    <th style="width:15%">Growth</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail && globalPerformanceDetail.comparisonData) { %>
                    <% globalPerformanceDetail.comparisonData.forEach(row => { %>
                        <tr>
                            <td class="metric-col"><div class="truncate"><%= row.metric %></div></td>
                            <% enabledChannelsList.forEach(channel => { %>
                                <td style="text-align:center;font-size:10px;"><%= row.channels?.[channel] || '-' %></td>
                            <% }) %>
                            <td style="text-align:center;font-weight:700;color:var(--text-dark);"><%= row.thisMonth %></td>
                            <td style="text-align:center;"><%= row.lastMonth %></td>
                            <td style="text-align:center;color:<%= row.growth.includes('+') ? 'var(--success-green)' : 'var(--error-red)' %>;font-weight:700;"><%= row.growth %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted);">Data tidak tersedia</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- AI Conclusions -->
    <div style="padding: 14px 24mm 0;">
        <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail && globalPerformanceDetail.aiConclusion) { %>
            <div class="summary-box">
                <p class="summary-box__title">AI-Powered Insights</p>
                <% globalPerformanceDetail.aiConclusion.forEach((point, i) => { %>
                    <p style="font-size:10px;color:var(--text-body);line-height:1.6;margin-bottom:4px;padding-left:18px;position:relative;">
                        <span style="position:absolute;left:0;font-weight:800;color:var(--accent);"><%= i + 1 %>.</span>
                        <%= point %>
                    </p>
                <% }) %>
            </div>
        <% } %>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     SHOPEE SECTION (Conditional)
     ============================================================ -->
<% if (typeof enabledChannels !== 'undefined' && enabledChannels && enabledChannels.shopee) { %>

<!-- Section Divider: Shopee -->
<div class="page">
    <div class="section-divider">
        <div class="section-divider-left">
            <div class="section-number-bg">03</div>
            <div class="section-number">03</div>
        </div>
        <div class="section-divider-right">
            <h1 class="section-title">Shopee<br>Performance</h1>
        </div>
    </div>
    <div class="page-footer" style="z-index:5;">
        <span style="color:rgba(255,255,255,0.5);"><%= brandName %> | <%= reportMonth %></span>
        <span style="color:rgba(255,255,255,0.5);">Page <%= nextPage() %></span>
    </div>
</div>

<!-- Store Performance -->
<div class="page">
    <div class="content-header">
        <h2>Store Performance</h2>
    </div>

    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 24mm;gap:20px;">
        <!-- Revenue KPI -->
        <div class="revenue-accent-box centered">
            <p class="revenue-label">Total Revenue</p>
            <p class="revenue-val">Rp <%= (typeof storePerformance !=='undefined' && storePerformance.totalRevenue) ? (storePerformance.totalRevenue/1000000).toFixed(1) : '0' %> M</p>
        </div>

        <!-- Donut Chart (New Buyers vs Old Buyers) -->
        <% var _sp=(typeof storePerformance!=='undefined' && storePerformance) ? storePerformance : {newBuyers:0,oldBuyers:0,adSalesRevenue:0,existingRevenue:0,totalRevenue:0,notes:''};
           var newBuyersPct=_sp.newBuyers||0;
           var oldBuyersPct=_sp.oldBuyers||0;
           var totalRev=_sp.totalRevenue||0;
           var adSalesRev=_sp.adSalesRevenue||0;
           var existingRev=_sp.existingRevenue||0;
        %>
        <div style="display:flex;justify-content:center;margin:20px 0;">
            <%- shopeeDonutSvg %>
        </div>

        <!-- Ad Sales vs Existing Table -->
        <table class="mini-summary-table" style="width:70%;">
            <thead><tr><th>Ad Sales</th><th>Existing</th></tr></thead>
            <tbody><tr>
                <td>Rp<%= (adSalesRev/1000000).toFixed(1) %>M</td>
                <td>Rp<%= (existingRev/1000000).toFixed(1) %>M</td>
            </tr></tbody>
        </table>

        <!-- Notes -->
        <div style="text-align:center;max-width:85%;margin:0 auto;">
            <div class="summary-box" style="text-align:left;">
                <% var _spNotes = _sp.notes || "Dapat dilihat bahwa kontribusi omset terbanyak datang dari penjualan iklan.";
                   var _spPoints = _spNotes.split(/(?:^|\s)(?:\d+[\.\)]\s*|- )/).filter(function(s){ return s.trim(); });
                   if (_spPoints.length > 1) { %>
                    <ul style="padding-left:16px;list-style-type:disc;margin:0;">
                        <% _spPoints.forEach(function(point) { %>
                            <li style="font-size:10px;color:var(--text-body);margin-bottom:3px;line-height:1.5;"><%= point.trim() %></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="summary-box__text"><%= _spNotes %></p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- Ads Performance -->
<div class="page">
    <div class="content-header">
        <h2>Ads Performance</h2>
    </div>
    <div style="padding: 0 24mm;">
        <div class="chart-placeholder" style="height:280px;border:none;background:#fff;">
            <% if (typeof adsChartUrl !=='undefined' && adsChartUrl) { %>
                <img src="<%= adsChartUrl %>" class="chart-img-placeholder" alt="Ads Performance Chart">
            <% } else { %>
                <div style="width:100%;height:100%;border:2px dashed var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);background:var(--primary-pale);">
                    [Ads Performance Chart]
                </div>
            <% } %>
        </div>
