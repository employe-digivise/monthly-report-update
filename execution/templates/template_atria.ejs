<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= brandName %> - Monthly Report
    </title>
    <style>
        <%- cssContent %>
    </style>
</head>

<body>

    <% var _pageCount=0; var nextPage=function() { return ++_pageCount; }; %>

        <!-- 1. COVER PAGE -->
        <div class="page">
            <div class="cover-page">
                <h1 class="cover-title">MONTHLY<br>PERFORMANCE<br>REPORT</h1>
                <p class="cover-brand">
                    <%= brandName %>
                </p>
                <p class="cover-month">
                    <%= reportMonth %>
                        <%= reportYear %>
                </p>
                <div class="cover-accent"></div>
            </div>
            <% if (typeof showLogo !=='undefined' && showLogo && typeof logoUrl !=='undefined' && logoUrl) { %>
                <img src="<%= logoUrl %>" class="agency-logo" alt="Agency Logo">
                <% } %>
                    <div class="page-footer">
                        <span>
                            <%= (typeof footerText !=='undefined' && footerText) ? ((typeof showLogo !== 'undefined' && showLogo) ? footerText : footerText.replace('DIGIVISE ', '')) : 'CONFIDENTIAL' %>
                        </span>
                        <span>Page <%= nextPage() %></span>
                    </div>
        </div>

        <!-- 2. SECTION DIVIDER: OVERVIEW -->
        <div class="page">
            <div class="section-divider">
                <div class="section-number">01</div>
                <h1 class="section-title">Performance Overview</h1>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 3. OPERATIONAL PERFORMANCE (Visual Reference 0) -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Performa Operasional Toko</h2>
            </div>
            <div class="vertical-stack-layout">
                <!-- Image Container -->
                <div class="screenshot-container">
                    <% if (typeof operationalScreenshots !=='undefined' && operationalScreenshots &&
                        operationalScreenshots.length> 0) { %>
                        <div class="screenshot-pair">
                            <% operationalScreenshots.slice(0, 2).forEach(src=> { %>
                                <img src="<%= src %>" class="screenshot-img" alt="Operational Screenshot">
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="screenshot-pair">
                                <div
                                    style="width: 100%; height: 150px; background: #e5e7eb; border: 2px dashed #9ca3af; display: flex; align-items: center; justify-content: center;">
                                    <span class="placeholder-text">[Screenshot 1 Placeholder - 5.7 x 1.5 in]</span>
                                </div>
                                <div
                                    style="width: 100%; height: 150px; background: #e5e7eb; border: 2px dashed #9ca3af; display: flex; align-items: center; justify-content: center;">
                                    <span class="placeholder-text">[Screenshot 2 Placeholder - 5.7 x 1.5 in]</span>
                                </div>
                            </div>
                            <% } %>
                </div>

                <!-- Checklist Container -->
                <div>
                    <ul class="checklist-container">
                        <li class="checklist-item">Tingkat pesanan tidak terselesaikan <%= (typeof metrics
                                !=='undefined' && metrics.unfulfilledOrders) ? metrics.unfulfilledOrders : 0 %>%
                        </li>
                        <li class="checklist-item">Tingkat keterlambatan pengiriman pesanan <%= (typeof metrics
                                !=='undefined' && metrics.lateShipment) ? metrics.lateShipment : 0 %>%
                        </li>
                        <li class="checklist-item">Persentase chat dibalas <%= (typeof metrics !=='undefined' &&
                                metrics.chatResponseRate) ? metrics.chatResponseRate : 0 %>%</li>
                        <li class="checklist-item">Keseluruhan penilaian <%= (typeof metrics !=='undefined' &&
                                metrics.overallRating) ? metrics.overallRating : 0 %>/5</li>
                    </ul>
                </div>
            </div>
            <div class="summary-container">
                <p style="font-size: 14px; color: var(--primary-blue);">
                    <%= (typeof metrics !=='undefined' && metrics.summary) ? metrics.summary : '' %>
                </p>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 4. PROMOTION TOOLS (Visual Reference 1) -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Tingkat Penggunaan Alat Promosi</h2>
            </div>
            <div class="vertical-stack-layout">
                <!-- Image Container -->
                <div class="screenshot-container">
                    <% if (typeof promotionScreenshots !=='undefined' && promotionScreenshots &&
                        promotionScreenshots.length> 0) { %>
                        <div class="screenshot-pair">
                            <% promotionScreenshots.slice(0, 2).forEach(src=> { %>
                                <img src="<%= src %>" class="screenshot-img" alt="Promotion Screenshot">
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="screenshot-pair">
                                <div
                                    style="width: 100%; height: 150px; background: #e5e7eb; border: 2px dashed #9ca3af; display: flex; align-items: center; justify-content: center;">
                                    <span class="placeholder-text">[Screenshot 1 Placeholder - 5.7 x 1.5 in]</span>
                                </div>
                                <div
                                    style="width: 100%; height: 150px; background: #e5e7eb; border: 2px dashed #9ca3af; display: flex; align-items: center; justify-content: center;">
                                    <span class="placeholder-text">[Screenshot 2 Placeholder - 5.7 x 1.5 in]</span>
                                </div>
                            </div>
                            <% } %>
                </div>

                <!-- Checklist Container -->
                <div>
                    <p style="font-size: 14px; font-weight: 700; margin-bottom: 20px;">% Penggunaan alat promosi sudah
                        digunakan dengan baik</p>
                    <div style="width: 100%; height: 2px; background: var(--accent-amber); margin-bottom: 20px;"></div>
                    <ul class="checklist-container">
                        <% if (typeof promotionTools !=='undefined' && promotionTools) {
                            Object.keys(promotionTools).forEach(tool=> { %>
                            <% if (promotionTools[tool]) { %>
                                <li class="checklist-item">
                                    <%= tool.replace(/([A-Z])/g, ' $1' ).replace(/^./, str=> str.toUpperCase()) %>
                                        digunakan
                                </li>
                                <% } %>
                                    <% }) } %>
                    </ul>
                </div>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 5. SECTION DIVIDER: GLOBAL PERFORMANCE -->
        <div class="page">
            <div class="section-divider">
                <div class="section-number">02</div>
                <h1 class="section-title">Global Performance</h1>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 5. GLOBAL REVENUE (Visual Reference 2) -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Global Revenue</h2>
            </div>
            <%
                var _grA = (typeof globalRevenue !== 'undefined' && globalRevenue) ? globalRevenue : null;
                var _revArrA = (_grA && _grA.chartData && Array.isArray(_grA.chartData.revenueData)) ? _grA.chartData.revenueData : [];
                var _adsArrA = (_grA && _grA.chartData && Array.isArray(_grA.chartData.adsSpentData)) ? _grA.chartData.adsSpentData : [];
                var _lblArrA = (_grA && _grA.chartData && Array.isArray(_grA.chartData.labels)) ? _grA.chartData.labels : [];
                var _lastRevenueA = _revArrA.length > 0 ? (_revArrA[_revArrA.length - 1] || 0) : 0;
                var _lastAdsA = _adsArrA.length > 0 ? (_adsArrA[_adsArrA.length - 1] || 0) : 0;
                var _lastLabelA = _lblArrA.length > 0 ? _lblArrA[_lblArrA.length - 1] : '';
            %>
            <div style="display:flex;gap:16px;padding:0 20mm 14px;justify-content:center;">
                <div class="revenue-accent-box" style="flex:1;max-width:220px;text-align:center;">
                    <p class="revenue-label">Revenue<%= _lastLabelA ? ' — ' + _lastLabelA : '' %></p>
                    <p class="revenue-val">Rp <%= (_lastRevenueA/1000000000).toFixed(2) %>M</p>
                </div>
                <div class="revenue-accent-box" style="flex:1;max-width:220px;text-align:center;">
                    <p class="revenue-label">Ads Spent<%= _lastLabelA ? ' — ' + _lastLabelA : '' %></p>
                    <p class="revenue-val">Rp <%= (_lastAdsA/1000000000).toFixed(2) %>M</p>
                </div>
            </div>
            <div class="chart-container" style="position: relative; height: 350px; padding: 10px;">
                <% /* Safety check for globalRevenue */ const safeGlobalRevenue=(typeof globalRevenue !=='undefined' &&
                    globalRevenue) ? globalRevenue : { chartData: { labels: [], revenueData: [], adsSpentData: [] },
                    summary: '' }; const chartLabels=safeGlobalRevenue.chartData.labels || []; const
                    revenueData=safeGlobalRevenue.chartData.revenueData || []; const
                    adsData=safeGlobalRevenue.chartData.adsSpentData || []; const width=1000; const height=400; const
                    padding={ top: 60, right: 30, bottom: 40, left: 60 }; const chartWidth=width - padding.left -
                    padding.right; const chartHeight=height - padding.top - padding.bottom; const
                    maxRevenue=revenueData.length> 0 ? Math.max(...revenueData) : 0;
                    const maxAds=adsData.length > 0 ? Math.max(...adsData) : 0;
                    const maxValue=(Math.max(maxRevenue, maxAds) || 1) * 1.2;

                    const getX=(index)=>
                    padding.left + (index * (chartWidth / (chartLabels.length - 1 || 1)));
                    const barWidth = chartLabels.length > 0 ? (chartWidth / chartLabels.length) * 0.6 : 0;
                    const getBarX = (index) => padding.left + (index * (chartWidth / (chartLabels.length || 1))) +
                    ((chartWidth /
                    (chartLabels.length || 1)) - barWidth) / 2;
                    const getY = (value) => height - padding.bottom - (value / maxValue) * chartHeight;
                    const formatCurrency = (val) => {
                    if (val >= 1000000000) return 'Rp' + (val / 1000000000).toFixed(1) + 'M';
                    if (val >= 1000000) return 'Rp' + (val / 1000000).toFixed(0) + 'jt';
                    return 'Rp' + val.toLocaleString('id-ID');
                    };
                    const formatFullCurrency = (val) => 'Rp' + val.toLocaleString('id-ID');
                    %>

                    <!-- Legend -->
                    <div
                        style="display: flex; justify-content: center; gap: 20px; margin-bottom: 10px; font-size: 10px;">
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <span
                                style="width: 12px; height: 12px; background: var(--primary-blue); display: inline-block;"></span>
                            Global Revenue
                        </div>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <span
                                style="width: 12px; height: 12px; background: var(--accent-amber); border-radius: 50%; display: inline-block; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--accent-amber);"></span>
                            Global Ads Spent
                        </div>
                    </div>

                    <svg viewBox="0 0 <%= width %> <%= height %>" class="chart-svg"
                        style="width: 100%; height: 100%; font-family: 'Inter', sans-serif;">
                        <!-- Grid Lines -->
                        <% for(let i=0; i <=5; i++) { const y=height - padding.bottom - (i * chartHeight / 5); const
                            value=(maxValue / 5) * i; %>
                            <line x1="<%= padding.left %>" y1="<%= y %>" x2="<%= width - padding.right %>" y2="<%= y %>"
                                stroke="#e5e7eb" stroke-width="1" />
                            <text x="<%= padding.left - 10 %>" y="<%= y + 4 %>" text-anchor="end" font-size="10"
                                fill="#6b7280">
                                <%= formatCurrency(value) %>
                            </text>
                            <% } %>

                                <!-- Bars (Revenue) -->
                                <% revenueData.forEach((val, i)=> {
                                    const x = getBarX(i);
                                    const y = getY(val);
                                    const h = height - padding.bottom - y;
                                    %>
                                    <rect x="<%= x %>" y="<%= y %>" width="<%= barWidth %>" height="<%= h %>"
                                        fill="var(--primary-blue)" rx="2" />
                                    <!-- Value Label -->
                                    <text x="<%= x + barWidth/2 %>" y="<%= y - 5 %>" text-anchor="middle" font-size="9"
                                        font-weight="bold" fill="var(--primary-blue)">
                                        <%= formatFullCurrency(val) %>
                                    </text>
                                    <% }) %>

                                        <!-- Line (Ads Spent) -->
                                        <polyline fill="none" stroke="var(--accent-amber)" stroke-width="3" points="
                        <%= adsData.map((val, i) => {
                            const x = getBarX(i) + barWidth/2; // Center on bar
                            const y = getY(val);
                            return `${x},${y}`;
                        }).join(' ') %>
                    " />

                                        <!-- Points (Ads Spent) -->
                                        <% adsData.forEach((val, i)=> {
                                            const x = getBarX(i) + barWidth/2;
                                            const y = getY(val);
                                            %>
                                            <circle cx="<%= x %>" cy="<%= y %>" r="4" fill="var(--accent-amber)"
                                                stroke="#fff" stroke-width="2" />
                                            <!-- Value Label (Orange) -->
                                            <text x="<%= x %>" y="<%= y - 10 %>" text-anchor="middle" font-size="9"
                                                font-weight="bold" fill="var(--accent-amber)" dy="-5">
                                                <%= formatFullCurrency(val) %>
                                            </text>
                                            <% }) %>

                                                <!-- X Axis Labels -->
                                                <% chartLabels.forEach((label, i)=> {
                                                    const x = getBarX(i) + barWidth/2;
                                                    const y = height - padding.bottom + 20;
                                                    %>
                                                    <text x="<%= x %>" y="<%= y %>" text-anchor="middle" font-size="10"
                                                        fill="#374151">
                                                        <%= label %>
                                                    </text>
                                                    <% }) %>
                    </svg>
            </div>
            <div class="summary-container" style="margin-top: -20px;">
                <div class="summary-header">Summary :</div>
                <div class="summary-item">
                    <span class="number">1.</span>
                    <span>
                        <%= safeGlobalRevenue.summary %>
                    </span>
                </div>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 6. GLOBAL PERFORMANCE DETAIL (Visual Reference 4) -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Global Performance</h2>
            </div>
            <div class="table-container" style="padding: 0 20mm;">
                <% const channelOrder=['shopee', 'tiktok' , 'tokopedia' , 'lazada' , 'blibli' ]; const
                    safeEnabledChannels=(typeof enabledChannels !=='undefined' && enabledChannels) ? enabledChannels :
                    {}; const enabledChannelsList=channelOrder.filter(ch=> safeEnabledChannels[ch]);
                    const channelCount = enabledChannelsList.length;
                    const metricWidth = 20;
                    const fixedColsWidth = 45;
                    const availableWidth = 100 - metricWidth - fixedColsWidth;
                    const channelColWidth = channelCount > 0 ? (availableWidth / channelCount).toFixed(1) : 0;
                    %>
                    <table class="performance-table">
                        <thead>
                            <tr>
                                <th style="width: <%= metricWidth %>%">Metriks</th>
                                <% enabledChannelsList.forEach(channel=> { %>
                                    <th style="width: <%= channelColWidth %>%">
                                        <%= channel.toUpperCase() %>
                                    </th>
                                    <% }) %>
                                        <th style="width: 15%">THIS MONTH</th>
                                        <th style="width: 15%">LAST MONTH</th>
                                        <th style="width: 15%">GROWTH</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail &&
                                globalPerformanceDetail.comparisonData) { %>
                                <% globalPerformanceDetail.comparisonData.forEach(row=> { %>
                                    <tr>
                                        <td class="metric-col">
                                            <div class="truncate">
                                                <%= row.metric %>
                                            </div>
                                        </td>
                                        <% enabledChannelsList.forEach(channel=> { %>
                                            <td style="text-align: center; font-size: 11px;">
                                                <%= row.channels?.[channel] || '-' %>
                                            </td>
                                            <% }) %>
                                                <td>
                                                    <%= row.thisMonth %>
                                                </td>
                                                <td>
                                                    <%= row.lastMonth %>
                                                </td>
                                                <td
                                                    style="color: <%= row.growth.includes('+') ? 'var(--success-green)' : 'var(--error-red)' %>; font-weight: 700;">
                                                    <%= row.growth %>
                                                </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" style="text-align: center; padding: 20px;">Data tidak
                                                    tersedia</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
            </div>
            <div class="summary-container">
                <div class="summary-header">Summary:</div>
                <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail &&
                    globalPerformanceDetail.aiConclusion) { %>
                    <% globalPerformanceDetail.aiConclusion.forEach((point, i)=> { %>
                        <div class="summary-item">
                            <span class="number">
                                <%= i + 1 %>.
                            </span>
                            <span>
                                <%= point %>
                            </span>
                        </div>
                        <% }) %>
                            <% } %>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 8. SECTION DIVIDER: SHOPEE PERFORMANCE -->
        <% if (typeof enabledChannels !== 'undefined' && enabledChannels && enabledChannels.shopee) { %>
        <div class="page">
            <div class="section-divider">
                <div class="section-number">03</div>
                <h1 class="section-title">Shopee Performance</h1>
            </div>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 9. STORE PERFORMANCE -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Store Performance</h2>
            </div>

            <div
                style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 20mm; gap: 30px;">
                <!-- 1. TOTAL REVENUE -->
                <div class="revenue-accent-box centered">
                    <p class="revenue-label">TOTAL REVENUE</p>
                    <p class="revenue-val">Rp <%= (typeof storePerformance !=='undefined' &&
                            storePerformance.totalRevenue) ? (storePerformance.totalRevenue/1000000).toFixed(1) : '0' %>
                            M</p>
                </div>

                <!-- 2. PIE CHART (SVG Donut - pre-computed in generator.js) -->
                <% var _sp=(typeof storePerformance!=='undefined'
                    &&storePerformance)?storePerformance:{adSales:0,existingSales:0,totalRevenue:0,notes:''}; %>
                    <% var adSalesPercent=_sp.adSales||0; var existingPercent=_sp.existingSales||0; var
                        totalRev=_sp.totalRevenue||0; %>
                        <% var adSalesRevenue=totalRev*adSalesPercent/100; var
                            existingRevenue=totalRev*existingPercent/100; %>
                            <div style="display:flex;justify-content:center;">
                                <%- shopeeDonutSvg %>
                            </div>

                            <!-- 3. TABLE -->
                            <table class="mini-summary-table" style="width: 80%;">
                                <thead>
                                    <tr>
                                        <th>Ad Sales</th>
                                        <th>Existing</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            Rp<%= (adSalesRevenue/1000000).toFixed(1) %>M
                                        </td>
                                        <td>
                                            Rp<%= (existingRevenue/1000000).toFixed(1) %>M
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- 4. SUMMARY TEXT -->
                            <div class="summary-container" style="padding: 0; text-align: center;">
                                <p style="font-size: 12px; line-height: 1.5; max-width: 80%; margin: 0 auto;">
                                    <%= _sp.notes
                                        || "Dapat dilihat bahwa kontribusi omset terbanyak datang dari penjualan iklan."
                                        %>
                                </p>
                            </div>
            </div>

            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

        <!-- 10. ADS PERFORMANCE -->
        <div class="page">
            <div class="dashboard-header">
                <h2>Ads Performance</h2>
            </div>
            <div class="chart-container">
                <div class="chart-placeholder" style="height: 300px; border: none; background: #fff;">
                    <% if (typeof adsChartUrl !=='undefined' && adsChartUrl) { %>
                        <img src="<%= adsChartUrl %>" class="chart-img-placeholder" alt="Ads Performance Chart">
                        <% } else { %>
                            <div
                                style="width: 100%; height: 100%; border: 2px dashed #E5E7EB; display: flex; align-items: center; justify-content: center; color: #9ca3af;">
                                [Ads Performance Chart Image Placeholder]
                            </div>
                            <% } %>
                </div>
                <div style="display: flex; justify-content: center; gap: 30px; font-size: 11px; margin-top: 20px;">
                    <span style="display: flex; align-items: center; gap: 8px;"><i
                            style="width: 10px; height: 10px; background: var(--accent-amber); border-radius: 50%; display: inline-block;"></i>
                        Penjualan dari Iklan</span>
                    <span style="display: flex; align-items: center; gap: 8px;"><i
                            style="width: 10px; height: 10px; background: var(--primary-blue); border-radius: 50%; display: inline-block;"></i>
                        Biaya Iklan</span>
                </div>
            </div>
            <div style="padding: 0 20mm;">
                <table class="horizontal-metrics-table">
                    <thead>
                        <tr>
                            <th style="width: 15%">DILIHAT</th>
                            <th style="width: 10%">CTR</th>
                            <th style="width: 15%">KLIK</th>
                            <th style="width: 15%">CPC</th>
                            <th style="width: 25%">PENJUALAN</th>
                            <th style="width: 20%">BIAYA</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof shopeeAdsMetrics !=='undefined' && shopeeAdsMetrics) { %>
                            <tr>
                                <td>
                                    <%= shopeeAdsMetrics.dilihat?.toLocaleString() || '-' %>
                                </td>
                                <td>
                                    <%= shopeeAdsMetrics.ctr || '-' %>
                                </td>
                                <td>
                                    <%= shopeeAdsMetrics.klik?.toLocaleString() || '-' %>
                                </td>
                                <td>
                                    <%= shopeeAdsMetrics.cpc || '-' %>
                                </td>
                                <td>
                                    <%= shopeeAdsMetrics.penjualan || '-' %>
                                </td>
                                <td>
                                    <%= shopeeAdsMetrics.biaya || '-' %>
                                </td>
                            </tr>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted);">Data tidak
                                        tersedia</td>
                                </tr>
                                <% } %>
                    </tbody>
                </table>
            </div>
            <% if (typeof shopeeAdsSummary !=='undefined' && shopeeAdsSummary) { %>
            <div class="summary-container" style="margin-top: 10px;">
                    <p style="font-size: 12px; color: var(--primary-blue); font-weight: 700;">Summary:</p>
                    <p style="font-size: 11px; line-height: 1.4; margin-top: 5px;">
                        <%= shopeeAdsSummary %>
                    </p>
            </div>
            <% } %>
            <div class="page-footer">
                <span>
                    <%= brandName %> | <%= reportMonth %>
                </span>
                <span>Page <%= nextPage() %></span>
            </div>
        </div>

            <!-- 11. TOP PRODUCTS -->
            <div class="page">
                <div class="dashboard-header">
                    <h2>Top Products</h2>
                </div>
                <div class="table-container" style="padding: 0 20mm;">
                    <table class="action-table">
                        <thead class="table-header">
                            <tr>
                                <th
                                    style="width: 5%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    No
                                </th>
                                <th
                                    style="width: 40%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    Produk</th>
                                <th
                                    style="width: 15%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    Foto Produk</th>
                                <th
                                    style="width: 10%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    Proporsi</th>
                                <th
                                    style="width: 10%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    QTY</th>
                                <th
                                    style="width: 20%; text-align: center; background: var(--primary-blue); color: #fff;">
                                    Penjualan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let i=0; i < 5; i++) { const product=(typeof topProducts !=='undefined' &&
                                topProducts[i]) ? topProducts[i] : null; %>
                                <tr class="zebra-row">
                                    <td style="text-align: center; font-weight: 700; border: 1px solid #E5E7EB;">
                                        <%= i + 1 %>
                                    </td>
                                    <td style="border: 1px solid #E5E7EB; vertical-align: middle;">
                                        <%= product ? product.name : '-' %>
                                    </td>
                                    <td style="border: 1px solid #E5E7EB;">
                                        <div class="product-photo-cell">
                                            <% if (product && product.image) { %>
                                                <img src="<%= product.image %>" class="product-photo-img" alt="">
                                                <% } else { %>
                                                    <span style="color: #9ca3af; font-size: 10px;">-</span>
                                                    <% } %>
                                        </div>
                                    </td>
                                    <td style="text-align: center; border: 1px solid #E5E7EB;">
                                        <%= product ? product.soldPercent : '-' %>
                                    </td>
                                    <td style="text-align: center; border: 1px solid #E5E7EB;">
                                        <%= product ? product.qty.toLocaleString() : '-' %>
                                    </td>
                                    <td style="text-align: center; border: 1px solid #E5E7EB;">
                                        <%= product ? 'Rp ' + (product.revenue/1000000).toFixed(1) + 'M' : '-' %>
                                    </td>
                                </tr>
                                <% } %>
                        </tbody>
                    </table>
                </div>
                <div class="page-footer">
                    <span>
                        <%= brandName %> | <%= reportMonth %>
                    </span>
                    <span>Page <%= nextPage() %></span>
                </div>
            </div>
            <% } %>

            <!-- 12. CPAS DATA (AWARENESS) -->
            <% if (typeof enabledChannels !=='undefined' && enabledChannels && enabledChannels.cpas && typeof cpas_data
                !=='undefined' && cpas_data) { %>
                <div class="page">
                    <div class="section-divider">
                        <div class="section-number">04</div>
                        <h1 class="section-title">CPAS Performance</h1>
                    </div>
                    <div class="page-footer">
                        <span>
                            <%= brandName %> | <%= reportMonth %>
                        </span>
                        <span>Page <%= nextPage() %></span>
                    </div>
                </div>

                <div class="page">
                    <div class="dashboard-header">
                        <h2>CPAS Performance</h2>
                    </div>
                    <div style="padding: 0 10mm;">
                        <table class="cpas-table">
                            <thead>
                                <tr style="background: var(--primary-blue); color: white;">
                                    <th rowspan="2" style="width: 20%">OBJECTIVE</th>
                                    <th rowspan="2" style="width: 25%">METRICS</th>
                                    <th colspan="2">PERIODE</th>
                                    <th rowspan="2" style="width: 15%">GROWTH (%)</th>
                                </tr>
                                <tr style="background: var(--primary-blue); color: white;">
                                    <th style="width: 20%; background: var(--primary-blue); color: white;">
                                        <%= cpas_data.period[0] %>
                                    </th>
                                    <th style="width: 20%; background: var(--primary-blue); color: white;">
                                        <%= cpas_data.period[1] %>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (cpas_data.awareness_nv && Array.isArray(cpas_data.awareness_nv) ?
                                    cpas_data.awareness_nv : []).forEach((row, i)=> { %>
                                    <tr>
                                        <% if (i===0) { %>
                                            <td rowspan="<%= (cpas_data.awareness_nv && Array.isArray(cpas_data.awareness_nv) ? cpas_data.awareness_nv : []).length %>"
                                                class="objective-col">
                                                AWARENESS (NV)</td>
                                            <% } %>
                                                <td style="text-align: left; font-weight: 500;">
                                                    <%= row.metric || '-' %>
                                                </td>
                                                <td>
                                                    <%= row.prev !==null && row.prev !==undefined ? row.prev : '0' %>
                                                </td>
                                                <td>
                                                    <%= row.current !==null && row.current !==undefined ? row.current
                                                        : '0' %>
                                                </td>
                                                <td>
                                                    <%= row.growth !==null && row.growth !==undefined ? row.growth
                                                        : '0%' %>
                                                </td>
                                    </tr>
                                    <% }) %>

                                        <tr style="background: var(--primary-blue); color: white;">
                                            <th rowspan="2" class="objective-col">OBJECTIVE</th>
                                            <th rowspan="2">METRICS</th>
                                            <th colspan="2">PERIODE</th>
                                            <th rowspan="2">GROWTH (%)</th>
                                        </tr>
                                        <tr style="background: var(--primary-blue); color: white;">
                                            <th style="background: var(--primary-blue); color: white;">
                                                <%= cpas_data.period[0] %>
                                            </th>
                                            <th style="background: var(--primary-blue); color: white;">
                                                <%= cpas_data.period[1] %>
                                            </th>
                                        </tr>

                                        <% (cpas_data.conversion_rm && Array.isArray(cpas_data.conversion_rm) ?
                                            cpas_data.conversion_rm : []).forEach((row, i)=> { %>
                                            <tr>
                                                <% if (i===0) { %>
                                                    <td rowspan="<%= (cpas_data.conversion_rm && Array.isArray(cpas_data.conversion_rm) ? cpas_data.conversion_rm : []).length %>"
                                                        class="objective-col">
                                                        CONVERSION (RM)</td>
                                                    <% } %>
                                                        <td style="text-align: left; font-weight: 500;">
                                                            <%= row.metric || '-' %>
                                                        </td>
                                                        <td>
                                                            <%= row.prev !==null && row.prev !==undefined ? row.prev
                                                                : '0' %>
                                                        </td>
                                                        <td>
                                                            <%= row.current !==null && row.current !==undefined ?
                                                                row.current : '0' %>
                                                        </td>
                                                        <td>
                                                            <%= row.growth !==null && row.growth !==undefined ?
                                                                row.growth : '0%' %>
                                                        </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="page-footer">
                        <span>
                            <%= brandName %> | <%= reportMonth %>
                        </span>
                        <span>Page <%= nextPage() %></span>
                    </div>
                </div>

                <!-- 14. BEST CAMPAIGN NV -->
                <div class="page">
                    <div class="dashboard-header">
                        <h2>Best Campaign NV</h2>
                    </div>
                    <div class="best-campaign-container">
                        <div class="best-campaign-item">
                            <!-- Images Grid -->
                            <div class="best-campaign-image-grid">
                                <% if (cpas_data.best_campaigns.nv.images && cpas_data.best_campaigns.nv.images.length>
                                    0) {
                                    %>
                                    <% cpas_data.best_campaigns.nv.images.slice(0, 2).forEach(img=> { %>
                                        <img src="<%= img %>" class="best-campaign-img" alt="NV Campaign">
                                        <% }) %>
                                            <% if (cpas_data.best_campaigns.nv.images.length < 2) { %>
                                                <div class="best-campaign-image-placeholder">[Image 2 Placeholder]</div>
                                                <% } %>
                                                    <% } else { %>
                                                        <div class="best-campaign-image-placeholder">[Image 1
                                                            Placeholder]
                                                        </div>
                                                        <div class="best-campaign-image-placeholder">[Image 2
                                                            Placeholder]
                                                        </div>
                                                        <% } %>
                            </div>

                            <!-- Metrics Table -->
                            <table class="best-campaign-table" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="width: 30%">NV Campaign</th>
                                        <th>Impresi</th>
                                        <th>CTR</th>
                                        <th>Amount Spend</th>
                                        <th>ATC</th>
                                        <th>C/ATC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="font-weight: 600;">
                                            <%= cpas_data.best_campaigns.nv.name || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.nv.impression !==null &&
                                                cpas_data.best_campaigns.nv.impression !==undefined ?
                                                cpas_data.best_campaigns.nv.impression : '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.nv.ctr || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.nv.spend || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.nv.atc !==null &&
                                                cpas_data.best_campaigns.nv.atc !==undefined ?
                                                cpas_data.best_campaigns.nv.atc : '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.nv.c_atc || '-' %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="page-footer">
                        <span>
                            <%= brandName %> | <%= reportMonth %>
                        </span>
                        <span>Page <%= nextPage() %></span>
                    </div>
                </div>

                <!-- 15. BEST CAMPAIGN RM -->
                <div class="page">
                    <div class="dashboard-header">
                        <h2>Best Campaign RM</h2>
                    </div>
                    <div class="best-campaign-container">
                        <div class="best-campaign-item">
                            <!-- Images Grid -->
                            <div class="best-campaign-image-grid">
                                <% if (cpas_data.best_campaigns.rm.images && cpas_data.best_campaigns.rm.images.length>
                                    0) {
                                    %>
                                    <% cpas_data.best_campaigns.rm.images.slice(0, 2).forEach(img=> { %>
                                        <img src="<%= img %>" class="best-campaign-img" alt="RM Campaign">
                                        <% }) %>
                                            <% if (cpas_data.best_campaigns.rm.images.length < 2) { %>
                                                <div class="best-campaign-image-placeholder">[Image 2 Placeholder]</div>
                                                <% } %>
                                                    <% } else { %>
                                                        <div class="best-campaign-image-placeholder">[Image 1
                                                            Placeholder]
                                                        </div>
                                                        <div class="best-campaign-image-placeholder">[Image 2
                                                            Placeholder]
                                                        </div>
                                                        <% } %>
                            </div>

                            <!-- Metrics Table -->
                            <table class="best-campaign-table" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="width: 30%">RM Campaign</th>
                                        <th>Frequency</th>
                                        <th>Amount Spend</th>
                                        <th>Total Revenue</th>
                                        <th>QTY</th>
                                        <th>ROAS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="font-weight: 600;">
                                            <%= cpas_data.best_campaigns.rm.name || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.rm.frequency !==null &&
                                                cpas_data.best_campaigns.rm.frequency !==undefined ?
                                                cpas_data.best_campaigns.rm.frequency : '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.rm.spend || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.rm.revenue || '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.rm.qty !==null &&
                                                cpas_data.best_campaigns.rm.qty !==undefined ?
                                                cpas_data.best_campaigns.rm.qty : '-' %>
                                        </td>
                                        <td>
                                            <%= cpas_data.best_campaigns.rm.roas || '-' %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="page-footer">
                        <span>
                            <%= brandName %> | <%= reportMonth %>
                        </span>
                        <span>Page <%= nextPage() %></span>
                    </div>
                </div>
                <% } %>


                    <!-- TIKTOK SECTION -->
                    <% if (typeof enabledChannels !=='undefined' && enabledChannels && enabledChannels.tiktok && typeof
                        tiktok_data !=='undefined' && tiktok_data) { %>
                        <!-- 16. SECTION DIVIDER: TIKTOK -->
                        <div class="page">
                            <div class="section-divider">
                                <div class="section-number">05</div>
                                <h1 class="section-title">Tiktok Performance</h1>
                            </div>
                            <div class="page-footer">
                                <span>
                                    <%= brandName %> | <%= reportMonth %>
                                </span>
                                <span>Page <%= nextPage() %></span>
                            </div>
                        </div>

                        <!-- 16. TIKTOK STORE PERFORMANCE -->
                        <div class="page">
                            <div class="dashboard-header">
                                <h2>Store Performance</h2>
                            </div>

                            <div
                                style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 20mm; gap: 20px;">

                                <!-- TOTAL REVENUE -->
                                <div class="revenue-accent-box centered">
                                    <p class="revenue-label">TOTAL REVENUE</p>
                                    <p class="revenue-val">Rp<%=
                                            tiktok_data.store_performance.total_revenue.toLocaleString('id-ID') %>
                                    </p>
                                </div>

                                <!-- PIE CHART (TikTok - pre-computed in generator.js) -->
                                <% var _tc=tiktok_data.store_performance.composition; var comp=_tc; %>
                                    <% var pVideo=_tc.video.percentage||0; var pLive=_tc.live_streaming.percentage||0;
                                        var pCard=_tc.product_card.percentage||0; %>
                                        <div style="display:flex;justify-content:center;">
                                            <%- tiktokDonutSvg %>
                                        </div>

                                        <!-- COMPOSITION TABLE -->
                                        <table class="blue-header-table">
                                            <thead>
                                                <tr>
                                                    <th>VIDEO</th>
                                                    <th>LIVE STREAMING</th>
                                                    <th>KARTU PRODUK</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="font-weight: 700; font-size: 14px;">Rp<%=
                                                            comp.video.revenue.toLocaleString('id-ID') %>
                                                    </td>
                                                    <td style="font-weight: 700; font-size: 14px;">Rp<%=
                                                            comp.live_streaming.revenue.toLocaleString('id-ID') %>
                                                    </td>
                                                    <td style="font-weight: 700; font-size: 14px;">Rp<%=
                                                            comp.product_card.revenue.toLocaleString('id-ID') %>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                        <!-- SUMMARY -->
                                        <div class="summary-container" style="padding: 10px 0; width: 100%;">
                                            <p style="font-size: 14px; color: var(--primary-blue); margin-bottom: 5px;">
                                                Summary:
                                            </p>
                                            <ul style="padding-left: 20px; list-style-type: disc;">
                                                <% tiktok_data.store_performance.summary.forEach(point=> { %>
                                                    <li
                                                        style="font-size: 12px; color: var(--primary-blue); margin-bottom: 5px;">
                                                        <%= point %>
                                                    </li>
                                                    <% }) %>
                                            </ul>
                                        </div>
                            </div>

                            <div class="page-footer">
                                <span>
                                    <%= brandName %> | <%= reportMonth %>
                                </span>
                                <span>Page <%= nextPage() %></span>
                            </div>
                        </div>

                        <!-- 17. TIKTOK GMV MAX PERFORMANCE -->
                        <div class="page">
                            <div class="dashboard-header">
                                <h2>GMV Max Performance</h2>
                            </div>

                            <div style="padding: 0 20mm;">
                                <table class="blue-header-table">
                                    <thead>
                                        <tr>
                                            <th rowspan="2" style="width: 25%; vertical-align: middle;">METRICS</th>
                                            <th colspan="2">Periode</th>
                                            <th rowspan="2" style="width: 20%; vertical-align: middle;">Growth</th>
                                        </tr>
                                        <tr>
                                            <th>
                                                <%= tiktok_data.gmv_max_performance.period[0] %>
                                            </th>
                                            <th>
                                                <%= tiktok_data.gmv_max_performance.period[1] %>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% tiktok_data.gmv_max_performance.metrics.forEach(row=> { %>
                                            <tr>
                                                <td
                                                    style="background: var(--primary-blue); color: white; text-align: center; font-weight: 700;">
                                                    <%= row.metric %>
                                                </td>
                                                <td>
                                                    <%= row.prev %>
                                                </td>
                                                <td>
                                                    <%= row.current %>
                                                </td>
                                                <td>
                                                    <%= row.growth %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="page-footer">
                                <span>
                                    <%= brandName %> | <%= reportMonth %>
                                </span>
                                <span>Page <%= nextPage() %></span>
                            </div>
                        </div>
                        <% } %>

                            <!-- 15/18. ACTION PLAN -->
                            <div class="page">
                                <div class="dashboard-header">
                                    <h2>Action Plan & Next Steps</h2>
                                </div>
                                <div class="table-container" style="padding: 0 20mm;">
                                    <table class="action-table">
                                        <thead class="table-header">
                                            <tr>
                                                <th style="width: 10%">Priority</th>
                                                <th style="width: 30%">Problem</th>
                                                <th style="width: 35%">Solution</th>
                                                <th style="width: 15%">PIC</th>
                                                <th style="width: 10%">Deadline</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (typeof actionPlan !=='undefined' && Array.isArray(actionPlan)) { %>
                                                <% actionPlan.forEach(plan=> { %>
                                                    <tr class="zebra-row">
                                                        <td>
                                                            <span
                                                                class="priority-badge priority-<%= plan.priority.toLowerCase() %>">
                                                                <%= plan.priority %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <%= plan.problem %>
                                                        </td>
                                                        <td>
                                                            <%= plan.solution %>
                                                        </td>
                                                        <td>
                                                            <%= plan.pic %>
                                                        </td>
                                                        <td>
                                                            <%= plan.deadline %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="page-footer">
                                    <span>
                                        <%= brandName %> | <%= reportMonth %>
                                    </span>
                                    <span>Page <%= nextPage() %></span>
                                </div>
                            </div>

</body>

</html>