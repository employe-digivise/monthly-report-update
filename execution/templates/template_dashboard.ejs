<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= brandName %> - Monthly Report</title>
    <style><%- cssContent %></style>
</head>

<body>

<% var _pageCount=0; var nextPage=function() { return ++_pageCount; }; %>

<!-- ============================================================
     1. COVER PAGE — Dashboard Split Design
     ============================================================ -->
<div class="page" style="background:#fff;">
    <div class="cover-page">
        <div class="cover-top-area">
            <p class="cover-label">Monthly Performance Report</p>
            <h1 class="cover-title">MONTHLY<br>PERFORMANCE<br>REPORT</h1>
        </div>
        <div class="cover-bottom-area">
            <p class="cover-brand"><%= brandName %></p>
            <p class="cover-month"><%= reportMonth %> &mdash; <%= reportYear %></p>
        </div>
    </div>
    <% if (typeof showLogo !=='undefined' && showLogo && typeof logoUrl !=='undefined' && logoUrl) { %>
        <img src="<%= logoUrl %>" class="agency-logo" alt="Agency Logo">
    <% } %>
    <div class="page-footer">
        <span><%= (typeof footerText !=='undefined' && footerText) ? ((typeof showLogo !== 'undefined' && showLogo) ? footerText : footerText.replace('DIGIVISE ', '')) : 'CONFIDENTIAL' %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     2. SECTION DIVIDER: OVERVIEW
     ============================================================ -->
<div class="page">
    <div class="section-divider">
        <div class="section-number">01</div>
        <h1 class="section-title">Performance<br>Overview</h1>
    </div>
    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     3. OPERATIONAL PERFORMANCE — KPI Hero Cards + Screenshots
     ============================================================ -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Performance Overview</p>
        <h2>Performa Operasional Toko</h2>
    </div>

    <!-- KPI Hero Cards (2x2) -->
    <div class="kpi-hero-grid">
        <div class="kpi-hero-card">
            <p class="kpi-hero-card__label">Pesanan Tidak Terselesaikan</p>
            <p class="kpi-hero-card__value"><%= (typeof metrics !=='undefined' && metrics.unfulfilledOrders) ? metrics.unfulfilledOrders : 0 %><span class="kpi-hero-card__suffix">%</span></p>
        </div>
        <div class="kpi-hero-card">
            <p class="kpi-hero-card__label">Keterlambatan Pengiriman</p>
            <p class="kpi-hero-card__value"><%= (typeof metrics !=='undefined' && metrics.lateShipment) ? metrics.lateShipment : 0 %><span class="kpi-hero-card__suffix">%</span></p>
        </div>
        <div class="kpi-hero-card kpi-hero-card--accent">
            <p class="kpi-hero-card__label">Chat Dibalas</p>
            <p class="kpi-hero-card__value" style="color:var(--accent);"><%= (typeof metrics !=='undefined' && metrics.chatResponseRate) ? metrics.chatResponseRate : 0 %><span class="kpi-hero-card__suffix">%</span></p>
        </div>
        <div class="kpi-hero-card kpi-hero-card--green">
            <p class="kpi-hero-card__label">Penilaian Keseluruhan</p>
            <p class="kpi-hero-card__value" style="color:var(--tertiary);"><%= (typeof metrics !=='undefined' && metrics.overallRating) ? metrics.overallRating : 0 %><span class="kpi-hero-card__suffix">/5</span></p>
        </div>
    </div>

    <!-- Screenshots in Card -->
    <div class="dash-card" style="margin-top:4px;">
        <div class="screenshot-container" style="background:transparent;border:none;padding:0;min-height:auto;">
            <% if (typeof operationalScreenshots !=='undefined' && operationalScreenshots && operationalScreenshots.length > 0) { %>
                <div class="screenshot-pair">
                    <% operationalScreenshots.slice(0, 2).forEach(src => { %>
                        <img src="<%= src %>" class="screenshot-img" alt="Operational Screenshot">
                    <% }) %>
                </div>
            <% } else { %>
                <div class="screenshot-pair">
                    <div style="width:100%;height:100px;background:var(--bg-light);border:2px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 1 Placeholder]</span>
                    </div>
                    <div style="width:100%;height:100px;background:var(--bg-light);border:2px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 2 Placeholder]</span>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Summary -->
    <% if (typeof metrics !=='undefined' && metrics.summary) { %>
    <div class="dash-card" style="margin-top:8px;padding:12px 16px;border-left:3px solid var(--primary);">
        <p style="font-size:10px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;font-family:'Montserrat',sans-serif;">Summary</p>
        <p style="font-size:11px;color:var(--text-body);line-height:1.5;"><%= metrics.summary %></p>
    </div>
    <% } %>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     4. PROMOTION TOOLS
     ============================================================ -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Performance Overview</p>
        <h2>Tingkat Penggunaan Alat Promosi</h2>
    </div>

    <!-- Screenshots -->
    <div class="dash-card">
        <div class="screenshot-container" style="background:transparent;border:none;padding:0;min-height:auto;">
            <% if (typeof promotionScreenshots !=='undefined' && promotionScreenshots && promotionScreenshots.length > 0) { %>
                <div class="screenshot-pair">
                    <% promotionScreenshots.slice(0, 2).forEach(src => { %>
                        <img src="<%= src %>" class="screenshot-img" alt="Promotion Screenshot">
                    <% }) %>
                </div>
            <% } else { %>
                <div class="screenshot-pair">
                    <div style="width:100%;height:100px;background:var(--bg-light);border:2px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 1 Placeholder]</span>
                    </div>
                    <div style="width:100%;height:100px;background:var(--bg-light);border:2px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                        <span class="placeholder-text">[Screenshot 2 Placeholder]</span>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Checklist -->
    <div style="padding: 12px 18mm 0;">
        <p style="font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;margin-bottom:10px;color:var(--text-dark);">Penggunaan Alat Promosi</p>
        <ul class="checklist-container">
            <% if (typeof promotionTools !=='undefined' && promotionTools) {
                Object.keys(promotionTools).forEach(tool => { %>
                <% if (promotionTools[tool]) { %>
                    <li class="checklist-item">
                        <%= tool.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %> digunakan
                    </li>
                <% } %>
            <% }) } %>
        </ul>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     5. SECTION DIVIDER: GLOBAL PERFORMANCE
     ============================================================ -->
<div class="page">
    <div class="section-divider">
        <div class="section-number">02</div>
        <h1 class="section-title">Global<br>Performance</h1>
    </div>
    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     6. GLOBAL REVENUE CHART
     ============================================================ -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Global Performance</p>
        <h2>Global Revenue</h2>
    </div>

    <%
        var _grD = (typeof globalRevenue !== 'undefined' && globalRevenue) ? globalRevenue : null;
        var _revArrD = (_grD && _grD.chartData && Array.isArray(_grD.chartData.revenueData)) ? _grD.chartData.revenueData : [];
        var _adsArrD = (_grD && _grD.chartData && Array.isArray(_grD.chartData.adsSpentData)) ? _grD.chartData.adsSpentData : [];
        var _lblArrD = (_grD && _grD.chartData && Array.isArray(_grD.chartData.labels)) ? _grD.chartData.labels : [];
        var _lastRevenueD = _revArrD.length > 0 ? (_revArrD[_revArrD.length - 1] || 0) : 0;
        var _lastAdsD = _adsArrD.length > 0 ? (_adsArrD[_adsArrD.length - 1] || 0) : 0;
        var _lastLabelD = _lblArrD.length > 0 ? _lblArrD[_lblArrD.length - 1] : '';
        function _fmtRpD(v) {
            if (v >= 1000000000) return 'Rp ' + (v/1000000000).toFixed(2) + 'M';
            if (v >= 1000000) return 'Rp ' + (v/1000000).toFixed(2) + 'jt';
            if (v >= 1000) return 'Rp ' + (v/1000).toFixed(0) + 'rb';
            return 'Rp ' + v;
        }
    %>
    <div style="display:flex;gap:12px;margin-bottom:10px;">
        <div class="dash-card" style="flex:1;text-align:center;">
            <p class="revenue-label">Revenue<%= _lastLabelD ? ' — ' + _lastLabelD : '' %></p>
            <p class="revenue-val"><%= _fmtRpD(_lastRevenueD) %></p>
        </div>
        <div class="dash-card" style="flex:1;text-align:center;">
            <p class="revenue-label">Ads Spent<%= _lastLabelD ? ' — ' + _lastLabelD : '' %></p>
            <p class="revenue-val"><%= _fmtRpD(_lastAdsD) %></p>
        </div>
    </div>

    <!-- Chart Card -->
    <div class="dash-card" style="padding:16px 14px;">
        <% const safeGlobalRevenue=(typeof globalRevenue !=='undefined' && globalRevenue) ? globalRevenue : { chartData: { labels: [], revenueData: [], adsSpentData: [] }, summary: '' };
           const chartLabels=safeGlobalRevenue.chartData.labels || [];
           const revenueData=safeGlobalRevenue.chartData.revenueData || [];
           const adsData=safeGlobalRevenue.chartData.adsSpentData || [];
           const width=1000; const height=400;
           const padding={ top: 60, right: 30, bottom: 40, left: 60 };
           const chartWidth=width - padding.left - padding.right;
           const chartHeight=height - padding.top - padding.bottom;
           const maxRevenue=revenueData.length > 0 ? Math.max(...revenueData) : 0;
           const maxAds=adsData.length > 0 ? Math.max(...adsData) : 0;
           const maxValue=(Math.max(maxRevenue, maxAds) || 1) * 1.2;
           const getX=(index) => padding.left + (index * (chartWidth / (chartLabels.length - 1 || 1)));
           const barWidth = chartLabels.length > 0 ? (chartWidth / chartLabels.length) * 0.5 : 0;
           const getBarX = (index) => padding.left + (index * (chartWidth / (chartLabels.length || 1))) + ((chartWidth / (chartLabels.length || 1)) - barWidth) / 2;
           const getY = (value) => height - padding.bottom - (value / maxValue) * chartHeight;
           const formatCurrency = (val) => {
               if (val >= 1000000000) return 'Rp' + (val / 1000000000).toFixed(1) + 'M';
               if (val >= 1000000) return 'Rp' + (val / 1000000).toFixed(0) + 'jt';
               return 'Rp' + val.toLocaleString('id-ID');
           };
           const formatFullCurrency = (val) => 'Rp' + val.toLocaleString('id-ID');
        %>

        <!-- Legend -->
        <div style="display:flex;justify-content:flex-end;gap:20px;margin-bottom:8px;font-size:9px;color:var(--text-muted);">
            <div style="display:flex;align-items:center;gap:5px;">
                <span style="width:10px;height:10px;background:var(--primary);border-radius:3px;display:inline-block;"></span>
                Revenue
            </div>
            <div style="display:flex;align-items:center;gap:5px;">
                <span style="width:10px;height:10px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
                Ads Spent
            </div>
        </div>

        <svg viewBox="0 0 <%= width %> <%= height %>" style="width:100%;height:auto;font-family:'Inter',sans-serif;">
            <!-- Grid Lines -->
            <% for(let i=0; i<=5; i++) { const y=height - padding.bottom - (i * chartHeight / 5); const value=(maxValue / 5) * i; %>
                <line x1="<%= padding.left %>" y1="<%= y %>" x2="<%= width - padding.right %>" y2="<%= y %>" stroke="#E5E7EB" stroke-width="1" />
                <text x="<%= padding.left - 10 %>" y="<%= y + 4 %>" text-anchor="end" font-size="9" fill="#9CA3AF"><%= formatCurrency(value) %></text>
            <% } %>

            <!-- Bars (Revenue) with rounded tops -->
            <% revenueData.forEach((val, i) => {
                const x = getBarX(i);
                const y = getY(val);
                const h = height - padding.bottom - y;
            %>
                <rect x="<%= x %>" y="<%= y %>" width="<%= barWidth %>" height="<%= h %>" fill="var(--primary)" rx="4" opacity="0.85" />
                <text x="<%= x + barWidth/2 %>" y="<%= y - 6 %>" text-anchor="middle" font-size="8" font-weight="700" fill="var(--primary)"><%= formatFullCurrency(val) %></text>
            <% }) %>

            <!-- Line (Ads Spent) -->
            <polyline fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="<%= adsData.map((val, i) => { const x = getBarX(i) + barWidth/2; const y = getY(val); return `${x},${y}`; }).join(' ') %>" />

            <!-- Points (Ads Spent) -->
            <% adsData.forEach((val, i) => {
                const x = getBarX(i) + barWidth/2;
                const y = getY(val);
            %>
                <circle cx="<%= x %>" cy="<%= y %>" r="4" fill="var(--accent)" stroke="#fff" stroke-width="2" />
                <text x="<%= x %>" y="<%= y - 12 %>" text-anchor="middle" font-size="8" font-weight="700" fill="var(--accent)"><%= formatFullCurrency(val) %></text>
            <% }) %>

            <!-- X Axis Labels -->
            <% chartLabels.forEach((label, i) => {
                const x = getBarX(i) + barWidth/2;
                const y = height - padding.bottom + 20;
            %>
                <text x="<%= x %>" y="<%= y %>" text-anchor="middle" font-size="9" fill="#6B7280"><%= label %></text>
            <% }) %>
        </svg>
    </div>

    <!-- Summary Card -->
    <div class="dash-card" style="margin-top:8px;padding:12px 16px;border-left:3px solid var(--primary);">
        <p style="font-size:10px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;font-family:'Montserrat',sans-serif;">Summary</p>
        <p style="font-size:11px;color:var(--text-body);line-height:1.5;"><%= safeGlobalRevenue.summary %></p>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     7. GLOBAL PERFORMANCE DETAIL TABLE
     ============================================================ -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Global Performance</p>
        <h2>Global Performance</h2>
    </div>

    <div class="dash-card--flush dash-card">
        <div class="table-container" style="padding:0;">
            <% const channelOrder=['shopee','tiktok','tokopedia','lazada','blibli'];
               const safeEnabledChannels=(typeof enabledChannels !=='undefined' && enabledChannels) ? enabledChannels : {};
               const enabledChannelsList=channelOrder.filter(ch => safeEnabledChannels[ch]);
               const channelCount = enabledChannelsList.length;
               const metricWidth = 20;
               const fixedColsWidth = 45;
               const availableWidth = 100 - metricWidth - fixedColsWidth;
               const channelColWidth = channelCount > 0 ? (availableWidth / channelCount).toFixed(1) : 0;
            %>
            <table class="performance-table">
                <thead>
                    <tr>
                        <th style="width:<%= metricWidth %>%;border-radius:10px 0 0 0;">Metriks</th>
                        <% enabledChannelsList.forEach(channel => { %>
                            <th style="width:<%= channelColWidth %>%"><%= channel.toUpperCase() %></th>
                        <% }) %>
                        <th style="width:15%">This Month</th>
                        <th style="width:15%">Last Month</th>
                        <th style="width:15%;border-radius:0 10px 0 0;">Growth</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail && globalPerformanceDetail.comparisonData) { %>
                        <% globalPerformanceDetail.comparisonData.forEach(row => { %>
                            <tr>
                                <td class="metric-col"><div class="truncate"><%= row.metric %></div></td>
                                <% enabledChannelsList.forEach(channel => { %>
                                    <td style="text-align:center;font-size:10px;"><%= row.channels?.[channel] || '-' %></td>
                                <% }) %>
                                <td style="text-align:center;font-weight:600;"><%= row.thisMonth %></td>
                                <td style="text-align:center;"><%= row.lastMonth %></td>
                                <td style="text-align:center;color:<%= row.growth.includes('+') ? 'var(--success-green)' : 'var(--error-red)' %>;font-weight:700;"><%= row.growth %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted);">Data tidak tersedia</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- AI Conclusion -->
    <% if (typeof globalPerformanceDetail !=='undefined' && globalPerformanceDetail && globalPerformanceDetail.aiConclusion) { %>
    <div class="dash-card" style="margin-top:8px;padding:12px 16px;">
        <p style="font-size:10px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;font-family:'Montserrat',sans-serif;">Summary</p>
        <% globalPerformanceDetail.aiConclusion.forEach((point, i) => { %>
            <p style="font-size:10px;color:var(--text-body);line-height:1.5;margin-bottom:4px;padding-left:16px;position:relative;">
                <span style="position:absolute;left:0;font-weight:700;color:var(--primary);"><%= i + 1 %>.</span>
                <%= point %>
            </p>
        <% }) %>
    </div>
    <% } %>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- ============================================================
     SHOPEE SECTION (Conditional)
     ============================================================ -->
<% if (typeof enabledChannels !== 'undefined' && enabledChannels && enabledChannels.shopee) { %>

<!-- Section Divider: Shopee -->
<div class="page">
    <div class="section-divider">
        <div class="section-number">03</div>
        <h1 class="section-title">Shopee<br>Performance</h1>
    </div>
    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- Store Performance — Side-by-Side Donut + Table -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Shopee Performance</p>
        <h2>Store Performance</h2>
    </div>

    <!-- Revenue KPI Card -->
    <div class="dash-card" style="text-align:center;margin-bottom:10px;">
        <p class="revenue-label">Total Revenue</p>
        <p class="revenue-val">Rp <%= (typeof storePerformance !=='undefined' && storePerformance.totalRevenue) ? (storePerformance.totalRevenue/1000000).toFixed(1) : '0' %> M</p>
    </div>

    <!-- Side-by-Side: Donut + Data -->
    <% var _sp=(typeof storePerformance!=='undefined' && storePerformance) ? storePerformance : {adSales:0,existingSales:0,totalRevenue:0,notes:''};
       var adSalesPercent=_sp.adSales||0;
       var existingPercent=_sp.existingSales||0;
       var totalRev=_sp.totalRevenue||0;
       var adSalesRevenue=totalRev*adSalesPercent/100;
       var existingRevenue=totalRev*existingPercent/100;
    %>
    <div class="dash-split" style="align-items:center;">
        <div class="dash-split__left" style="display:flex;justify-content:center;">
            <div class="dash-card--no-margin" style="background:var(--bg-card);border-radius:10px;border:1px solid var(--border);padding:16px;display:flex;justify-content:center;">
                <%- shopeeDonutSvg %>
            </div>
        </div>
        <div class="dash-split__right">
            <div class="dash-card--no-margin" style="background:var(--bg-card);border-radius:10px;border:1px solid var(--border);padding:0;overflow:hidden;">
                <table class="mini-summary-table" style="margin:0;">
                    <thead><tr><th>Ad Sales</th><th>Existing</th></tr></thead>
                    <tbody><tr>
                        <td>Rp<%= (adSalesRevenue/1000000).toFixed(1) %>M</td>
                        <td>Rp<%= (existingRevenue/1000000).toFixed(1) %>M</td>
                    </tr></tbody>
                </table>
            </div>
            <!-- Notes -->
            <div style="margin-top:12px;padding:10px 14px;background:var(--bg-card);border-radius:8px;border:1px solid var(--border);border-left:3px solid var(--primary);">
                <p style="font-size:10px;line-height:1.5;color:var(--text-body);">
                    <%= _sp.notes || "Dapat dilihat bahwa kontribusi omset terbanyak datang dari penjualan iklan." %>
                </p>
            </div>
        </div>
    </div>

    <div class="page-footer">
        <span><%= brandName %> | <%= reportMonth %></span>
        <span>Page <%= nextPage() %></span>
    </div>
</div>

<!-- Ads Performance -->
<div class="page">
    <div class="dash-page-header">
        <p class="dash-subtitle">Shopee Performance</p>
        <h2>Ads Performance</h2>
    </div>

    <!-- Chart Card -->
    <div class="dash-card" style="padding:10px;">
        <div class="chart-placeholder" style="height:260px;border:none;background:var(--bg-card);border-radius:8px;">
            <% if (typeof adsChartUrl !=='undefined' && adsChartUrl) { %>
                <img src="<%= adsChartUrl %>" class="chart-img-placeholder" alt="Ads Performance Chart">
            <% } else { %>
                <div style="width:100%;height:100%;border:2px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);">
                    [Ads Performance Chart]
                </div>
            <% } %>
        </div>
        <div style="display:flex;justify-content:center;gap:24px;font-size:10px;margin:12px 0 0;color:var(--text-muted);">
            <span style="display:flex;align-items:center;gap:6px;">
                <i style="width:8px;height:8px;background:var(--accent);border-radius:50%;display:inline-block;"></i>
                Penjualan dari Iklan
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
                <i style="width:8px;height:8px;background:var(--primary);border-radius:50%;display:inline-block;"></i>
                Biaya Iklan
            </span>
        </div>
    </div>

    <!-- Metrics Table Card -->
    <div class="dash-card--flush dash-card" style="margin-top:10px;">
        <table class="horizontal-metrics-table">
            <thead><tr>
                <th style="width:15%">Dilihat</th>
                <th style="width:10%">CTR</th>
                <th style="width:15%">Klik</th>
                <th style="width:15%">CPC</th>
                <th style="width:25%">Penjualan</th>
                <th style="width:20%">Biaya</th>
            </tr></thead>
            <tbody>
                <% if (typeof shopeeAdsMetrics !=='undefined' && shopeeAdsMetrics) { %>
                    <tr>
                        <td><%= shopeeAdsMetrics.dilihat?.toLocaleString() || '-' %></td>
                        <td><%= shopeeAdsMetrics.ctr || '-' %></td>
